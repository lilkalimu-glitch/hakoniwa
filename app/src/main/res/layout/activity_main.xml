<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Kopfzeile -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.16"
                    android:text="@string/title"
                    android:textColor="@color/text"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/title_jp"
                    android:textColor="@color/pink"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="@string/subtitle"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_off"
            android:fontFamily="monospace"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/status_off"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Auswahl: welches Programm in der VM läuft -->
    <LinearLayout
        android:id="@+id/systems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_segment_container"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/sys_mine"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_selected"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="@string/sys_mine"
            android:textColor="@color/on_mint"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sys_example"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="@string/sys_example"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Terminal: hier erscheint, was das Programm in der VM ausgibt -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_terminal">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fadeScrollbars="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:scrollbarStyle="outsideOverlay">

            <TextView
                android:id="@+id/terminal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.12"
                android:textColor="@color/vm_text"
                android:textIsSelectable="true"
                android:textSize="12.5sp" />
        </ScrollView>
    </FrameLayout>

    <!-- Schnellbefehle (nur beim Beispiel) -->
    <HorizontalScrollView
        android:id="@+id/chips_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Eingabe -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:hint="@string/input_hint"
            android:imeOptions="actionSend|flagNoExtractUi|flagNoFullscreen"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:textCursorDrawable="@drawable/cursor"
            android:textSize="14sp" />

        <Button
            android:id="@+id/send"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_primary"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="18dp"
            android:stateListAnimator="@null"
            android:text="@string/send"
            android:textAllCaps="false"
            android:textColor="@color/on_mint"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Steuerung -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/start"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="@string/btn_start"
            android:textAllCaps="false"
            android:textColor="@color/on_mint"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/stop"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="@string/btn_stop"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/restart"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="@string/btn_restart"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
